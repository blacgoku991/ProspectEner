---
import Brand from '../components/Brand.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Star from '../components/Star.astro';
import { fr, joinUrl, playUrl } from '../config/site';
import { factions, factionsCount } from '../data/factions';
import { metiers, metiersCount } from '../data/metiers';
import { totalRules } from '../data/reglement';
import Base from '../layouts/Base.astro';

const stats = [
  { value: metiersCount, pad: 2, label: 'métiers et entreprises', suffix: '' },
  { value: factionsCount, pad: 2, label: 'factions à rejoindre', suffix: '' },
  { value: totalRules, pad: 3, label: 'règles claires, zéro flou', suffix: '' },
  { value: 0, pad: 1, label: 'à payer pour jouer', suffix: ' €' },
];

const features = [
  {
    icon: 'rocket',
    title: 'Développement continu',
    text: 'Nouveaux métiers, scripts maison, équilibrages : la ville évolue au rythme des retours de celles et ceux qui la font vivre.',
    wide: true,
    visual: 'bars',
  },
  {
    icon: 'headphones',
    title: 'Staff présent',
    text: 'Des tickets traités par des humains, des décisions expliquées, une équipe qui joue aussi.',
  },
  {
    icon: 'hand-coins',
    title: 'Économie vivante',
    text: 'Salaires, commerces, marché noir : l’argent circule entre joueurs, pas depuis un menu.',
  },
  {
    icon: 'shield-check',
    title: 'Jeu propre',
    text: 'Anti-triche actif, journaux complets et sanctions cohérentes. Personne ne gâche ta scène.',
  },
  {
    icon: 'users',
    title: 'Débutants bienvenus',
    text: 'Jamais fait de roleplay ? Un parcours d’arrivée et des joueurs patients t’aident à trouver ta place, sans jugement.',
    wide: true,
    visual: 'path',
  },
  {
    icon: 'gauge',
    title: 'Performances soignées',
    text: 'Des scripts optimisés pour garder tes images par seconde, même quand la ville est pleine.',
  },
];

const steps = [
  {
    icon: 'download',
    title: 'Installe FiveM',
    text: 'Il te faut GTA V sur PC et le client FiveM, gratuit. Deux minutes, pas plus.',
  },
  {
    icon: 'message-circle',
    title: 'Passe par le Discord',
    text: 'Lis le règlement, récupère ton accès et dis bonjour. L’équipe répond à tes questions.',
  },
  {
    icon: 'gamepad-2',
    title: 'Entre en ville',
    text: 'Crée ton personnage, choisis ta première tenue, décroche ton premier job. Le reste s’écrit en jeu.',
  },
];

const marquee = ['Roleplay', 'Los Santos', 'Gratuit', 'Francophone', 'FiveM', 'Jour & nuit'];
const legalNames = ['LSPD', 'EMS', 'DOJ', 'Garages', 'Clubs', 'Restaurants', 'Médias'];
const illegalNames = factions.slice(0, 5).map((t) => t.title);
---

<Base>
  <!-- ============================================================ HERO -->
  <section class="hero" data-hero aria-label="Elyra">
    <canvas class="hero__canvas" data-city aria-hidden="true"></canvas>
    <div class="hero__fallback" aria-hidden="true"></div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__inner container">
      <div class="hero__top" data-hero-fade style="--i:0">
        <span class="chip hero__chip">
          <i class="dot"></i>
          <span data-server-count>Gratuit · ouvert à tous</span>
        </span>
        <span class="mono hero__meta">Serveur GTA RP · FiveM</span>
      </div>

      <h1 class="hero__title display h-hero">
        <span class="hero__line"><span style="--i:0">Une ville.</span></span>
        <span class="hero__line"><span class="grad-text" style="--i:1">Mille vies.</span></span>
      </h1>

      <div class="hero__row">
        <p class="lead hero__lead" data-hero-fade style="--i:2">
          Elyra est un serveur roleplay francophone et gratuit. Flic, médecin, patron de bar ou chef
          de gang&nbsp;: choisis ta place à Los Santos et fais-en une histoire qui mérite d’être
          racontée.
        </p>
        <div class="hero__cta" data-hero-fade style="--i:3">
          <Button href={joinUrl} label="Rejoindre Elyra" brand="discord" size="lg" magnetic />
          <Button href="/metiers" label="Voir les métiers" variant="ghost" size="lg" arrow />
        </div>
      </div>
    </div>

    <div class="hero__bottom container" data-hero-fade style="--i:4">
      <a class="hero__scroll mono" href="#manifeste">
        <span class="hero__scroll-line"></span>
        Défiler
      </a>
      <span class="mono hero__hud">
        <span>34.05° N</span><span>118.24° O</span>
        <span>Los Santos · <b data-clock>--:--</b></span>
      </span>
    </div>
  </section>

  <div class="sheet">
    <!-- ============================================================ BANDEAU -->
    <div class="strip" aria-hidden="true">
      <div class="marquee" style="--marquee-speed:44s;--marquee-gap:44px">
        {
          [0, 1].map(() => (
            <div class="marquee__track">
              {marquee.map((word, i) => (
                <>
                  <span class:list={['strip__word display', { 'outline-text': i % 2 === 1 }]}>{word}</span>
                  <Star size={34} class="strip__star" />
                </>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <!-- ============================================================ MANIFESTE -->
    <section class="section manifesto" id="manifeste">
      <div class="container manifesto__grid">
        <div class="manifesto__side">
          <p class="kicker" data-reveal>01 · Manifeste</p>
          <p class="manifesto__note" data-reveal style="--d:120">
            Pas de classement, pas de compteur de victimes. Juste des histoires bien jouées.
          </p>
        </div>
        <p class="manifesto__text" data-words>
          Ici, on ne gagne pas des scènes. On les écrit ensemble. Un contrôle routier, un deal qui
          tourne mal, une nuit de garde aux urgences&nbsp;: tout peut devenir le début d’une
          histoire. Elyra te donne la ville, les outils et le cadre. <em>Le reste, c’est toi.</em>
        </p>
      </div>

      <div class="container">
        <ul class="stats" data-stagger="110">
          {
            stats.map((s) => (
              <li class="stat" data-reveal>
                <span class="stat__value display">
                  <span data-count={s.value} data-pad={s.pad}>
                    {String(s.value).padStart(s.pad, '0')}
                  </span>
                  {s.suffix}
                </span>
                <span class="stat__label">{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============================================================ POINTS FORTS -->
    <section class="section features" id="serveur">
      <div class="container">
        <header class="section-head section-head--split">
          <div>
            <p class="kicker" data-reveal>02 · Le serveur</p>
            <h2 class="display h2" data-split>
              Pensé pour <span class="accent-text">durer</span>,<br />réglé pour jouer.
            </h2>
          </div>
          <p class="lead" data-reveal>
            Un bon serveur ne se résume pas à une liste de scripts. Voici ce sur quoi on ne transige
            pas.
          </p>
        </header>

        <div class="bento" data-stagger="80">
          {
            features.map((f, i) => (
              <div class:list={['bento__cell tilt-scene', { 'bento__cell--wide': f.wide }]} data-reveal="flip">
                <article class="card feature" data-spot data-tilt="5">
                  <span class="feature__index mono">0{i + 1}</span>
                  <span class="feature__icon tilt-pop-sm">
                    <Icon name={f.icon} size={24} />
                  </span>
                  <div class="feature__body">
                    <h3 class="h3">{f.title}</h3>
                    <p>{fr(f.text)}</p>
                  </div>
                  {f.visual === 'bars' && (
                    <div class="feature__bars" aria-hidden="true">
                      {[38, 62, 46, 78, 55, 92, 70, 100, 64, 84, 58, 96].map((h, k) => (
                        <span style={`--h:${h}%;--k:${k}`} />
                      ))}
                    </div>
                  )}
                  {f.visual === 'path' && (
                    <svg class="feature__path" viewBox="0 0 320 120" fill="none" aria-hidden="true">
                      <path
                        d="M8 100 C 60 100, 70 30, 120 34 S 190 96, 230 70 S 290 16, 312 14"
                        stroke="url(#fp)"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        pathLength="1"
                      />
                      <circle cx="8" cy="100" r="5" fill="#8f6bff" />
                      <circle cx="120" cy="34" r="5" fill="#c45ed0" />
                      <circle cx="230" cy="70" r="5" fill="#ff4fa3" />
                      <circle cx="312" cy="14" r="6" fill="#ffc56e" />
                      <defs>
                        <linearGradient id="fp" x1="0" y1="0" x2="320" y2="0" gradientUnits="userSpaceOnUse">
                          <stop stop-color="#8f6bff" />
                          <stop offset=".6" stop-color="#ff4fa3" />
                          <stop offset="1" stop-color="#ffc56e" />
                        </linearGradient>
                      </defs>
                    </svg>
                  )}
                  <span class="tilt-glare" />
                </article>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================ DEUX MONDES -->
    <section class="section worlds" id="mondes">
      <div class="container">
        <header class="section-head section-head--split">
          <div>
            <p class="kicker" data-reveal>03 · Deux mondes</p>
            <h2 class="display h2" data-split>De quel côté<br />de la loi&nbsp;?</h2>
          </div>
          <p class="lead" data-reveal>
            Les deux se croisent tous les soirs. C’est précisément ce qui rend la ville intéressante.
          </p>
        </header>

        <div class="worlds__grid">
          <a class="world world--legal" href="/metiers" data-theme="legal" data-cursor="Métiers" data-reveal="left">
            <span class="world__bg" aria-hidden="true"></span>
            <span class="world__ghost display" aria-hidden="true">Légal</span>
            <span class="corners" aria-hidden="true"></span>
            <div class="world__body">
              <span class="chip chip--accent"><b>{metiersCount}</b> métiers</span>
              <h3 class="world__title display">Sers<br />la ville.</h3>
              <p>
                Police, secours, justice, commerces. Porte l’uniforme ou monte ton entreprise, et
                fais tourner Los Santos.
              </p>
              <ul class="world__list">
                {legalNames.map((n) => <li>{n}</li>)}
              </ul>
              <span class="link-arrow">Voir les métiers <Icon name="arrow-up-right" size={17} /></span>
            </div>
          </a>

          <a
            class="world world--illegal"
            href="/factions"
            data-theme="illegal"
            data-cursor="Factions"
            data-reveal="right"
          >
            <span class="world__bg" aria-hidden="true"></span>
            <span class="world__ghost display" aria-hidden="true">Illégal</span>
            <span class="corners" aria-hidden="true"></span>
            <div class="world__body">
              <span class="chip chip--accent"><b>{factionsCount}</b> factions</span>
              <h3 class="world__title display">Ou<br />défie-la.</h3>
              <p>
                Gangs, familles, cartels, clubs de motards. Gagne ta place dans la rue, une scène
                après l’autre.
              </p>
              <ul class="world__list">
                {illegalNames.map((n) => <li>{n}</li>)}
              </ul>
              <span class="link-arrow">Voir les factions <Icon name="arrow-up-right" size={17} /></span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================ SECTEURS (défilement horizontal) -->
    <section class="sectors" id="secteurs" data-sectors>
      <div class="sectors__head container">
        <div>
          <p class="kicker" data-reveal>04 · Secteurs</p>
          <h2 class="display h2" data-split>Trouve ton métier.</h2>
        </div>
        <span class="mono sectors__hint" data-reveal>
          <Icon name="arrow-right" size={15} /> Fais défiler
        </span>
      </div>

      <div class="sectors__viewport" data-sectors-viewport>
        <div class="sectors__track" data-sectors-track>
          {
            metiers.map((cat, i) => (
              <a class="sector card" href={`/metiers#${cat.id}`} style={`--c:${cat.color}`} data-spot data-cursor="Ouvrir">
                <span class="sector__num display outline-text" aria-hidden="true">0{i + 1}</span>
                <span class="sector__icon"><Icon name={cat.icon} size={26} /></span>
                <p class="mono sector__kicker">{cat.kicker}</p>
                <h3 class="sector__title display">{cat.title}</h3>
                <p class="sector__desc">{fr(cat.desc)}</p>
                <ul class="sector__jobs">
                  {cat.jobs.map((j) => <li>{j.name}</li>)}
                </ul>
                <span class="sector__more mono">
                  {cat.jobs.length} entreprises <Icon name="arrow-up-right" size={15} />
                </span>
              </a>
            ))
          }
          <a class="sector sector--end" href="/metiers" data-cursor="Tout voir">
            <Star size={54} />
            <span class="display">Tous<br />les métiers</span>
            <span class="link-arrow">Explorer <Icon name="arrow-up-right" size={17} /></span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================ ÉTAPES -->
    <section class="section steps" id="rejoindre">
      <div class="container">
        <header class="section-head section-head--split">
          <div>
            <p class="kicker" data-reveal>05 · Arriver en ville</p>
            <h2 class="display h2" data-split>Trois étapes,<br />et tu y es.</h2>
          </div>
          <p class="lead" data-reveal>
            Aucune candidature pour commencer. Tu arrives, tu joues, et tu vois jusqu’où ton
            personnage t’emmène.
          </p>
        </header>

        <ol class="steps__list" data-stagger="140">
          {
            steps.map((s, i) => (
              <li class="step" data-reveal>
                <span class="step__num display">0{i + 1}</span>
                <span class="step__icon"><Icon name={s.icon} size={22} /></span>
                <h3 class="h3">{s.title}</h3>
                <p>{fr(s.text)}</p>
              </li>
            ))
          }
        </ol>

        <p class="steps__more" data-reveal>
          <a class="link-arrow" href="/rejoindre">Le guide d’arrivée complet <Icon name="arrow-up-right" size={17} /></a>
        </p>
      </div>
    </section>

    <!-- ============================================================ APPEL FINAL -->
    <section class="section section--tight outro">
      <div class="container">
        <div class="outro__panel" data-reveal="scale">
          <span class="outro__aurora" aria-hidden="true"></span>
          <span class="corners" aria-hidden="true"></span>
          <Star size={64} class="outro__star" />
          <h2 class="display h1 outro__title">Ta place<br /><span class="grad-text">t’attend.</span></h2>
          <p class="lead">La ville ne dort jamais. Viens écrire ta nuit.</p>
          <div class="outro__cta">
            <a class="outro__card" {...(joinUrl.startsWith('http') ? { href: joinUrl, target: '_blank', rel: 'noopener noreferrer' } : { href: joinUrl })} data-spot>
              <span class="outro__card-icon"><Brand name="discord" size={26} /></span>
              <span>
                <b>Discord</b>
                <small>Annonces, support, recrutements</small>
              </span>
              <Icon name="arrow-up-right" size={20} />
            </a>
            <a class="outro__card" {...(playUrl.startsWith('http') ? { href: playUrl, target: '_blank', rel: 'noopener noreferrer' } : { href: playUrl })} data-spot>
              <span class="outro__card-icon"><Brand name="fivem" size={26} /></span>
              <span>
                <b>Serveur FiveM</b>
                <small>Connexion directe à la ville</small>
              </span>
              <Icon name="arrow-up-right" size={20} />
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { gsap, holdIntro, onIntro, reduced, ScrollTrigger, SplitText } from '../scripts/app.ts';
  import type { CityHandle } from '../scripts/city.ts';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-city]');
  let city: CityHandle | null = null;
  let introFired = false;

  /* ---- Ville 3D ---- */
  if (hero && canvas) {
    const lowPower =
      window.matchMedia('(max-width: 820px)').matches || (navigator.hardwareConcurrency ?? 8) <= 4;

    const ready = import('../scripts/city.ts')
      .then(({ createCity }) => {
        city = createCity(canvas, { reduced, lowPower });
        hero.classList.add('has-city');
        city.setActive(true);
        sync();
        if (introFired) city.intro();
      })
      .catch((err) => {
        console.warn('Ville 3D indisponible :', err);
        hero.classList.add('no-webgl');
      });
    holdIntro(ready, 3000);

    const sync = () => {
      const p = Math.min(1, window.scrollY / Math.max(1, window.innerHeight));
      hero.style.setProperty('--hp', p.toFixed(4));
      city?.setScroll(p);
      city?.setActive(p < 0.985);
    };
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();

    onIntro(() => {
      introFired = true;
      hero.classList.add('is-in');
      city?.intro();
    });
  }

  /* ---- Horloge du HUD ---- */
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const tick = () => {
      const d = new Date();
      clock.textContent = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    };
    tick();
    window.setInterval(tick, 20000);
  }

  onIntro(() => {
    /* ---- Manifeste : les mots s'allument au fil du défilement ---- */
    const words = document.querySelector<HTMLElement>('[data-words]');
    if (words && !reduced) {
      SplitText.create(words, {
        type: 'words',
        wordsClass: 'word',
        autoSplit: true,
        onSplit: (self) =>
          gsap.fromTo(
            self.words,
            { opacity: 0.13 },
            {
              opacity: 1,
              ease: 'none',
              stagger: 0.06,
              scrollTrigger: { trigger: words, start: 'top 82%', end: 'bottom 48%', scrub: 0.5 },
            },
          ),
      });
    }

    /* ---- Secteurs : défilement horizontal épinglé (écrans larges) ---- */
    const section = document.querySelector<HTMLElement>('[data-sectors]');
    const viewport = document.querySelector<HTMLElement>('[data-sectors-viewport]');
    const track = document.querySelector<HTMLElement>('[data-sectors-track]');
    if (section && viewport && track && !reduced) {
      const mm = gsap.matchMedia();
      mm.add('(min-width: 900px) and (hover: hover)', () => {
        section.classList.add('is-pinned');
        const distance = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
        gsap.to(track, {
          x: () => -distance(),
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: () => `+=${distance()}`,
            pin: true,
            scrub: 0.7,
            invalidateOnRefresh: true,
            anticipatePin: 1,
          },
        });
        return () => section.classList.remove('is-pinned');
      });
    }

    /* ---- Bandeau : il s'incline selon la vitesse de défilement ---- */
    const strip = document.querySelector<HTMLElement>('.strip .marquee');
    if (strip && !reduced) {
      const skew = gsap.quickTo(strip, 'skewX', { duration: 0.6, ease: 'power3' });
      ScrollTrigger.create({
        onUpdate: (self) => skew(gsap.utils.clamp(-9, 9, self.getVelocity() / -260)),
      });
    }
  });
</script>

<style>
  /* ================================================================ HERO */
  .hero {
    --hp: 0;
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100vh;
    height: 100svh;
    min-height: 620px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: #05050b;
  }
  .hero__canvas,
  .hero__fallback,
  .hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__canvas {
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  .hero.has-city .hero__canvas {
    opacity: calc(1 - var(--hp) * 0.55);
  }
  /* Repli sans WebGL : un crépuscule en dégradés */
  .hero__fallback {
    background:
      radial-gradient(90% 55% at 62% 78%, rgba(255, 150, 90, 0.5), transparent 60%),
      radial-gradient(120% 70% at 55% 82%, rgba(255, 79, 163, 0.5), transparent 62%),
      linear-gradient(180deg, #05050b 0%, #150a2e 55%, #3a1150 100%);
    transition: opacity 0.8s;
  }
  .hero.has-city .hero__fallback {
    opacity: 0;
  }
  .hero__shade {
    background:
      linear-gradient(90deg, rgba(5, 5, 11, 0.9) 0%, rgba(5, 5, 11, 0.55) 40%, transparent 74%),
      linear-gradient(0deg, rgba(5, 5, 11, 0.96) 0%, rgba(5, 5, 11, 0.5) 30%, transparent 62%),
      linear-gradient(180deg, rgba(5, 5, 11, 0.7) 0%, transparent 22%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(18px, 2.4vw, 34px);
    padding-bottom: clamp(26px, 4vw, 54px);
    transform: translate3d(0, calc(var(--hp) * -110px), 0);
    opacity: calc(1 - var(--hp) * 1.7);
  }
  .hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }
  .hero__chip {
    color: var(--text);
    background: rgba(10, 10, 21, 0.55);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .hero__meta {
    color: var(--muted);
  }
  .hero__title {
    margin-left: -0.04em;
    text-shadow: 0 10px 60px rgba(5, 5, 11, 0.7);
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .hero__line > span {
    display: inline-block;
    padding-right: 0.06em;
  }
  :global(.js) .hero__line > span {
    transform: translate3d(0, 112%, 0) rotate(4deg);
    transform-origin: 0 100%;
    transition: transform 1.5s var(--ease-out);
    transition-delay: calc(0.08s + var(--i) * 0.13s);
  }
  :global(.js) .hero.is-in .hero__line > span {
    transform: none;
  }
  .hero__row {
    display: grid;
    gap: 26px;
    align-items: end;
  }
  @media (min-width: 980px) {
    .hero__row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 60px;
    }
  }
  .hero__lead {
    color: #d5d1e6;
    max-width: 54ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  :global(.js) [data-hero-fade] {
    opacity: 0;
    transform: translate3d(0, 26px, 0);
    transition:
      opacity 1.1s var(--ease-out),
