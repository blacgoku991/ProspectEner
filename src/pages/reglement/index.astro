---
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { fr, joinUrl } from '../../config/site';
import { bookMeta, books, bookStats, lexique, totalRules, type BookSlug } from '../../data/reglement';
import Base from '../../layouts/Base.astro';

const slugs = Object.keys(books) as BookSlug[];
const principles = books.global.chapters[0].sections.flatMap((s) => s.rules).slice(0, 5);
const blurbs: Record<BookSlug, string> = {
  global: 'Le socle commun. À lire en premier, quel que soit ton personnage.',
  legal: 'Police, secours, justice, gouvernement et entreprises.',
  illegal: 'Groupes, braquages, territoires et scènes sensibles.',
};
---

<Base
  title="Règlement"
  description="Le règlement d'Elyra en trois tomes : global, légal et illégal. Des règles claires, numérotées et faciles à retrouver."
>
  <PageHero
    kicker="Règlement · Vue d’ensemble"
    ghost="Règles"
    lead="Trois tomes, un seul esprit : protéger la qualité des scènes. Chaque règle est numérotée, classée par gravité et se retrouve en deux secondes."
  >
    <Fragment slot="title">Les règles <em>du jeu.</em></Fragment>
    <Fragment slot="meta">
      <span class="chip"><b>3</b> tomes</span>
      <span class="chip"><b>{totalRules}</b> règles</span>
      <span class="chip"><b>{lexique.length}</b> termes au lexique</span>
    </Fragment>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <div class="tomes" data-stagger="130">
        {
          slugs.map((slug) => {
            const book = books[slug];
            const meta = bookMeta[slug];
            const stats = bookStats(book);
            return (
              <div class="tilt-scene" data-reveal="flip">
                <a class="tome card" href={`/reglement/${slug}`} data-theme={meta.theme} data-spot data-tilt="8" data-cursor="Lire">
                  <span class="tome__bg" aria-hidden="true" />
                  <span class="tome__ghost display" aria-hidden="true">{meta.prefix}</span>
                  <div class="tome__top">
                    <span class="tome__icon tilt-pop"><Icon name={meta.icon} size={28} stroke={1.5} /></span>
                    <span class="mono tome__tag">{meta.tome}</span>
                  </div>
                  <div class="tome__body tilt-pop-sm">
                    <h2 class="display tome__title">{meta.short}</h2>
                    <p>{blurbs[slug]}</p>
                  </div>
                  <ul class="tome__stats">
                    <li><b class="display">{stats.chapters}</b><span class="mono">chapitres</span></li>
                    <li><b class="display">{stats.rules}</b><span class="mono">règles</span></li>
                    <li><b class="display tome__crit">{stats.critiques}</b><span class="mono">critiques</span></li>
                  </ul>
                  <ol class="tome__chapters">
                    {book.chapters.slice(0, 4).map((c, i) => (
                      <li><span class="mono">0{i + 1}</span>{fr(c.title)}</li>
                    ))}
                    {book.chapters.length > 4 && <li class="tome__more">+ {book.chapters.length - 4} autres chapitres</li>}
                  </ol>
                  <span class="tome__cta">
                    Lire le tome <Icon name="arrow-up-right" size={18} />
                  </span>
                  <span class="tilt-glare" />
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container principles">
      <header class="principles__head">
        <p class="kicker" data-reveal>L’essentiel</p>
        <h2 class="display h2" data-split>Cinq principes<br />avant tout le reste.</h2>
        <p class="lead" data-reveal>
          Si tu ne retiens que ça, tu éviteras neuf sanctions sur dix. Le détail est dans le
          règlement global.
        </p>
        <div data-reveal>
          <Button href="/reglement/global" label="Lire le règlement global" variant="ghost" arrow />
        </div>
      </header>
      <ol class="principles__list" data-stagger="100">
        {
          principles.map((rule, i) => (
            <li class="principle" data-reveal="right">
              <span class="principle__num display">0{i + 1}</span>
              <div>
                {rule.title && <h3 class="h3">{fr(rule.title)}</h3>}
                <p>{fr(rule.text)}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="levels" data-stagger="110">
        <article class="level card" data-reveal data-spot style="--spot:var(--red)">
          <span class="level__mark level__mark--crit"></span>
          <h3 class="h3">Règle critique</h3>
          <p>Un interdit grave. L’enfreindre expose à un bannissement, parfois dès la première fois.</p>
        </article>
        <article class="level card" data-reveal data-spot style="--spot:var(--amber)">
          <span class="level__mark level__mark--imp"></span>
          <h3 class="h3">Règle importante</h3>
          <p>Un point qui revient souvent en ticket. À connaître avant ta première scène.</p>
        </article>
        <article class="level card" data-reveal data-spot>
          <span class="level__mark"></span>
          <h3 class="h3">Un litige ?</h3>
          <p>
            On ne règle rien en pleine scène. Termine le jeu, garde ton clip, puis ouvre un ticket.
          </p>
          <a class="link-arrow" href={joinUrl}>Ouvrir un ticket <Icon name="arrow-up-right" size={17} /></a>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .tomes {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 980px) {
    .tomes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .tome {
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100%;
    min-height: 560px;
    padding: clamp(24px, 2.4vw, 34px);
    border-color: color-mix(in srgb, var(--a1) 26%, var(--line));
  }
  .tome__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(110% 60% at 0% 0%, color-mix(in srgb, var(--a1) 30%, transparent), transparent 60%),
      radial-gradient(90% 50% at 100% 100%, color-mix(in srgb, var(--a2) 22%, transparent), transparent 60%);
    transition: transform 1.4s var(--ease-out);
  }
  .tome:hover .tome__bg {
    transform: scale(1.15);
  }
  .tome__ghost {
    position: absolute;
    right: -0.04em;
    top: -0.1em;
    z-index: -1;
    font-size: 17rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--a1) 34%, transparent);
    transition: transform 1.2s var(--ease-out);
  }
  .tome:hover .tome__ghost {
    transform: translate(-14px, 10px) rotate(-4deg);
  }
  .tome__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    transform-style: preserve-3d;
  }
  .tome__icon {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 20px;
    color: #06060c;
    background: var(--grad-accent);
    box-shadow: 0 18px 40px -14px var(--a1);
  }
  .tome__tag {
    color: var(--a1);
  }
  .tome__body {
    display: grid;
    gap: 10px;
  }
  .tome__title {
    font-size: clamp(2.6rem, 4.4vw, 4rem);
  }
  .tome__body p {
    color: #cfcbe0;
    max-width: 30ch;
  }
  .tome__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-block: 18px;
    border-block: 1px solid var(--line);
  }
  .tome__stats li {
    display: grid;
    gap: 2px;
  }
  .tome__stats b {
    font-size: 1.9rem;
    line-height: 1;
  }
  .tome__stats .mono {
    font-size: 0.6rem;
    color: var(--muted);
  }
  .tome__crit {
    color: var(--red);
  }
  .tome__chapters {
    display: grid;
    gap: 9px;
    font-size: 0.92rem;
    font-weight: 600;
    color: #d5d1e6;
  }
  .tome__chapters li {
    display: flex;
    gap: 12px;
  }
  .tome__chapters .mono {
    color: var(--a1);
    padding-top: 2px;
  }
  .tome__more {
    color: var(--dim);
    padding-left: 34px;
  }
  .tome__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding: 15px 18px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--a1) 45%, transparent);
    font-weight: 700;
    transition:
      background-color 0.4s,
      color 0.3s;
  }
  .tome:hover .tome__cta {
    color: #06060c;
    background: var(--grad-accent);
  }

  .principles {
    display: grid;
    gap: 44px;
  }
  @media (min-width: 980px) {
    .principles {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      gap: 90px;
      align-items: start;
    }
    .principles__head {
      position: sticky;
      top: 140px;
    }
  }
  .principles__head {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .principle {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .principle:last-child {
    border-bottom: 1px solid var(--line);
  }
  .principle__num {
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    line-height: 0.9;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .principle div {
    display: grid;
    gap: 8px;
  }
  .principle p {
    color: var(--muted);
  }

  .levels {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 860px) {
    .levels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .level {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: start;
    padding: 28px;
  }
  .level p {
    color: var(--muted);
  }
  .level__mark {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    transform: rotate(45deg);
    background: var(--grad);
    margin-bottom: 8px;
  }
  .level__mark--crit {
    background: var(--red);
    box-shadow: 0 0 20px var(--red);
  }
  .level__mark--imp {
    background: var(--amber);
    box-shadow: 0 0 20px var(--amber);
  }
</style>
