---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { fr } from '../../config/site';
import { bookMeta, books, bookStats, lexique, type BookSlug } from '../../data/reglement';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return (Object.keys(books) as BookSlug[]).map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as BookSlug;
const book = books[slug];
const meta = bookMeta[slug];
const stats = bookStats(book);
const others = (Object.keys(books) as BookSlug[]).filter((s) => s !== slug);

const pad = (n: number) => String(n).padStart(2, '0');
const norm = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '');

// Numérotation : une suite par chapitre, ex. G·03.07
const chapters = book.chapters.map((chapter, ci) => {
  let n = 0;
  return {
    ...chapter,
    num: pad(ci + 1),
    id: `chapitre-${ci + 1}`,
    sections: chapter.sections.map((section, si) => ({
      ...section,
      id: `section-${ci + 1}-${si + 1}`,
      rules: section.rules.map((rule) => {
        n++;
        return {
          ...rule,
          code: `${meta.prefix}·${pad(ci + 1)}.${pad(n)}`,
          id: `${meta.prefix.toLowerCase()}-${ci + 1}-${n}`,
          search: norm([rule.title, rule.text, ...(rule.points ?? [])].filter(Boolean).join(' ')),
        };
      }),
    })),
  };
});

const kinds = { obligatoire: 'À respecter', interdit: 'Interdit', notion: 'Notion' } as const;
const titleWord = book.title.replace(/^Règlement\s+/i, '');
---

<Base title={book.title} theme={meta.theme} description={book.lead}>
  <PageHero kicker={`Règlement · ${meta.tome}`} ghost={titleWord} lead={fr(book.lead)}>
    <Fragment slot="title">Règlement <em>{titleWord}.</em></Fragment>
    <Fragment slot="meta">
      <span class="chip"><b>{stats.chapters}</b> chapitres</span>
      <span class="chip"><b>{stats.rules}</b> règles</span>
      <span class="chip chip--crit"><b>{stats.critiques}</b> critiques</span>
      {slug === 'global' && <span class="chip"><b>{lexique.length}</b> termes au lexique</span>}
    </Fragment>
  </PageHero>

  <div class="toolbar" data-rulebook-toolbar>
    <div class="container toolbar__inner">
      <label class="search">
        <Icon name="search" size={18} />
        <span class="sr-only">Rechercher dans le règlement</span>
        <input
          type="search"
          placeholder="Rechercher une règle, un mot-clé, un numéro…"
          autocomplete="off"
          spellcheck="false"
          data-rule-search
        />
        <kbd class="mono">/</kbd>
      </label>
      <div class="toolbar__filters" role="group" aria-label="Filtrer par niveau">
        <button class="pill is-active" type="button" data-level="all" aria-pressed="true">Toutes</button>
        <button class="pill pill--crit" type="button" data-level="critique" aria-pressed="false">
          <i class="lvl lvl--critique"></i>Critiques
        </button>
        <button class="pill pill--imp" type="button" data-level="importante" aria-pressed="false">
          <i class="lvl lvl--importante"></i>Importantes
        </button>
      </div>
    </div>
  </div>

  <div class="container book" data-rulebook>
    <aside class="toc" aria-label="Sommaire">
      <details class="toc__box" open>
        <summary class="toc__summary mono">
          Sommaire <Icon name="chevron-down" size={15} />
        </summary>
        <nav class="toc__nav" data-lenis-prevent>
          <ol>
            {
              chapters.map((ch) => (
                <li>
                  <a class="toc__chapter" href={`#${ch.id}`} data-toc={ch.id}>
                    <span class="mono">{ch.num}</span>
                    {fr(ch.title)}
                  </a>
                  {ch.sections.length > 1 && (
                    <ol class="toc__sections">
                      {ch.sections.map((s) => (
                        <li>
                          <a href={`#${s.id}`}>{fr(s.title)}</a>
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              ))
            }
            {
              slug === 'global' && (
                <li>
                  <a class="toc__chapter" href="#lexique" data-toc="lexique">
                    <span class="mono">A·Z</span>
                    Lexique
                  </a>
                </li>
              )
            }
          </ol>
        </nav>
      </details>
      <p class="toc__count mono" data-rule-count aria-live="polite">{stats.rules} règles</p>
    </aside>

    <div class="book__main">
      {
        chapters.map((ch) => (
          <section class="chapter" id={ch.id} data-chapter>
            <header class="chapter__head">
              <span class="chapter__num display" aria-hidden="true">{ch.num}</span>
              <div>
                <p class="kicker kicker--plain">Chapitre {ch.num}</p>
                <h2 class="display chapter__title">{fr(ch.title)}</h2>
                {ch.intro && <p class="chapter__intro">{fr(ch.intro)}</p>}
              </div>
            </header>

            {ch.sections.map((section) => (
              <div class="rsection" id={section.id} data-section>
                {(ch.sections.length > 1 || section.title !== ch.title) && (
                  <h3 class="rsection__title h3">{fr(section.title)}</h3>
                )}
                {section.intro && <p class="rsection__intro">{fr(section.intro)}</p>}

                <ol class="rules">
                  {section.rules.map((rule) => (
                    <li
                      class:list={['rule', rule.level && `rule--${rule.level}`]}
                      id={rule.id}
                      data-rule
                      data-level={rule.level ?? 'standard'}
                      data-search={`${rule.code.toLowerCase()} ${rule.search}`}
                    >
                      <div class="rule__meta">
                        <span class="rule__code mono">{rule.code}</span>
                        {rule.level && (
                          <span class:list={['rule__level mono', `rule__level--${rule.level}`]}>
                            <i class:list={['lvl', `lvl--${rule.level}`]} />
                            {rule.level === 'critique' ? 'Critique' : 'Importante'}
                          </span>
                        )}
                        <button
                          class="rule__link"
                          type="button"
                          data-copy={rule.id}
                          aria-label={`Copier le lien de la règle ${rule.code}`}
                        >
                          <Icon name="link" size={15} />
                        </button>
                      </div>
                      <div class="rule__body">
                        {rule.title && <h4 class="rule__title">{fr(rule.title)}</h4>}
                        <p>{fr(rule.text)}</p>
                        {rule.points && (
                          <ul class="rule__points">
                            {rule.points.map((p) => <li>{fr(p)}</li>)}
                          </ul>
                        )}
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </section>
        ))
      }

      {
        slug === 'global' && (
          <section class="chapter" id="lexique" data-chapter data-lexique>
            <header class="chapter__head">
              <span class="chapter__num display" aria-hidden="true">Aa</span>
              <div>
                <p class="kicker kicker--plain">Annexe</p>
                <h2 class="display chapter__title">Lexique</h2>
                <p class="chapter__intro">
                  Le vocabulaire du roleplay, pour que tout le monde parle de la même chose.
                </p>
              </div>
            </header>
            <dl class="lexique">
              {lexique.map((t) => (
                <div
                  class:list={['term', `term--${t.kind}`]}
                  data-rule
                  data-level="standard"
                  data-search={norm(`${t.term} ${t.full ?? ''} ${t.def}`)}
                >
                  <dt>
                    <span class="term__name display">{t.term}</span>
                    <span class:list={['term__kind mono', `term__kind--${t.kind}`]}>{kinds[t.kind]}</span>
                  </dt>
                  <dd>
                    {t.full && <span class="term__full">{t.full}</span>}
                    {fr(t.def)}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <div class="noresult" data-rule-empty hidden>
        <Icon name="search" size={26} />
        <p><b>Aucune règle ne correspond.</b> Essaie un autre mot-clé ou retire le filtre.</p>
        <button class="pill" type="button" data-rule-reset>Tout réafficher</button>
      </div>

      <nav class="tomes" aria-label="Autres règlements">
        {
          others.map((s) => (
            <a class="tome card" href={`/reglement/${s}`} data-theme={bookMeta[s].theme} data-spot>
              <span class="tome__icon"><Icon name={bookMeta[s].icon} size={22} /></span>
              <span>
                <small class="mono">{bookMeta[s].tome}</small>
                <b class="display">{books[s].title}</b>
              </span>
              <Icon name="arrow-up-right" size={20} />
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</Base>

<script>
  import '../../scripts/rulebook.ts';
</script>

<style>
  /* ---- Recherche ---- */
  .search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1 1 320px;
    min-width: 0;
    height: 48px;
    padding: 0 14px 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.04);
    color: var(--muted);
    transition:
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .search:focus-within {
    border-color: var(--a1);
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--a1) 18%, transparent);
    color: var(--text);
  }
  .search input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: none;
    font-size: 0.95rem;
  }
  .search input::placeholder {
    color: var(--dim);
  }
  .search input::-webkit-search-cancel-button {
    filter: invert(1) opacity(0.5);
  }
  .search kbd {
    display: none;
    padding: 4px 8px;
    border-radius: 7px;
    border: 1px solid var(--line-2);
    font-size: 0.68rem;
    color: var(--dim);
  }
  @media (min-width: 760px) {
    .search kbd {
      display: block;
    }
  }

  .lvl {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    transform: rotate(45deg);
    flex: none;
  }
  .lvl--critique {
    background: var(--red);
    box-shadow: 0 0 10px var(--red);
  }
  .lvl--importante {
    background: var(--amber);
    box-shadow: 0 0 10px var(--amber);
  }
  :global(.chip--crit) {
    color: var(--red);
    border-color: color-mix(in srgb, var(--red) 45%, transparent);
    background: color-mix(in srgb, var(--red) 9%, transparent);
  }
  :global(.chip--crit b) {
    color: var(--red);
  }

  /* ---- Mise en page ---- */
  .book {
    display: grid;
    gap: 30px;
    padding-top: clamp(30px, 4vw, 60px);
  }
  @media (min-width: 1020px) {
    .book {
      grid-template-columns: 290px minmax(0, 1fr);
      gap: 70px;
      align-items: start;
    }
  }

  /* ---- Sommaire ---- */
  .toc__box {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.025);
  }
  .toc__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }
  .toc__summary::-webkit-details-marker {
    display: none;
  }
  .toc__box[open] .toc__summary :global(svg) {
    transform: rotate(180deg);
  }
  .toc__nav {
    padding: 0 8px 10px;
  }
  @media (min-width: 1020px) {
    .toc {
      position: sticky;
      top: 170px;
    }
    .toc__box {
      border: 0;
      background: none;
    }
    .toc__summary {
      padding: 0 0 14px 12px;
      pointer-events: none;
    }
    .toc__summary :global(svg) {
      display: none;
    }
    .toc__nav {
      max-height: calc(100vh - 290px);
      padding: 0 8px 0 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: #2b2942 transparent;
      mask-image: linear-gradient(180deg, #000 calc(100% - 30px), transparent);
      -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 30px), transparent);
      padding-bottom: 30px;
    }
  }
  .toc__chapter {
    position: relative;
    display: flex;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--muted);
    transition:
      color 0.3s,
      background-color 0.3s;
  }
  .toc__chapter .mono {
    color: var(--dim);
    padding-top: 2px;
    transition: color 0.3s;
  }
  .toc__chapter:hover {
    color: var(--text);
  }
  .toc__chapter.is-current {
    color: var(--text);
    background: color-mix(in srgb, var(--a1) 10%, transparent);
  }
  .toc__chapter.is-current .mono {
    color: var(--a1);
  }
  .toc__sections {
    display: none;
    margin: 2px 0 8px 22px;
    padding-left: 16px;
    border-left: 1px solid var(--line-2);
  }
  .toc__chapter.is-current + .toc__sections {
    display: block;
  }
  .toc__sections a {
    display: block;
    padding: 5px 0;
    font-size: 0.84rem;
    color: var(--dim);
    transition: color 0.3s;
  }
  .toc__sections a:hover {
    color: var(--text);
  }
  .toc__count {
    margin-top: 16px;
    padding-left: 12px;
    color: var(--dim);
  }

  /* ---- Chapitres ---- */
  .chapter {
    padding-bottom: clamp(50px, 7vw, 100px);
  }
  .chapter[hidden],
  .rsection[hidden],
  .rule[hidden],
  .term[hidden] {
    display: none;
  }
  .chapter__head {
    position: relative;
    display: grid;
    gap: 18px;
    align-items: end;
    padding-bottom: 26px;
    margin-bottom: 30px;
    border-bottom: 1px solid var(--line-2);
  }
  @media (min-width: 700px) {
    .chapter__head {
      grid-template-columns: auto 1fr;
      gap: 28px;
    }
  }
  .chapter__head > div {
    display: grid;
    gap: 10px;
  }
  .chapter__num {
    font-size: clamp(4.4rem, 9vw, 8rem);
    line-height: 0.82;
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .chapter__title {
    font-size: clamp(1.8rem, 3.6vw, 3.1rem);
  }
  .chapter__intro {
    color: var(--muted);
    max-width: 62ch;
  }

  .rsection {
    padding-top: 26px;
  }
  .rsection + .rsection {
    margin-top: 22px;
  }
  .rsection__title {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .rsection__title::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 2px;
    transform: rotate(45deg);
    background: var(--grad-accent);
    flex: none;
  }
  .rsection__intro {
    margin-top: 8px;
    color: var(--muted);
    max-width: 68ch;
  }

  /* ---- Règles ---- */
  .rules {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }
  .rule {
    --lv: var(--line-2);
    position: relative;
    display: grid;
    gap: 12px;
    padding: 20px 22px 20px 26px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.015));
    scroll-margin-top: 190px;
    transition:
      border-color 0.4s,
      background-color 0.4s,
      transform 0.6s var(--ease-out);
  }
  .rule::before {
    content: '';
    position: absolute;
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--lv);
    transition: box-shadow 0.4s;
  }
  .rule:hover {
    border-color: var(--line-2);
    transform: translateX(4px);
  }
  .rule--critique {
    --lv: var(--red);
    background: linear-gradient(90deg, rgba(255, 84, 104, 0.09), rgba(255, 255, 255, 0.015) 60%);
  }
  .rule--importante {
    --lv: var(--amber);
    background: linear-gradient(90deg, rgba(255, 197, 110, 0.07), rgba(255, 255, 255, 0.015) 60%);
  }
  .rule--critique::before,
  .rule--importante::before {
    box-shadow: 0 0 16px var(--lv);
  }
  .rule.is-target {
    border-color: var(--a1);
    animation: flash 2.2s ease;
  }
  @keyframes flash {
    0%,
    40% {
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--a1) 30%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .rule__meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .rule__code {
    padding: 4px 9px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.07);
    font-size: 0.68rem;
    color: #d5d1e6;
    letter-spacing: 0.08em;
  }
  .rule__level {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.64rem;
  }
  .rule__level--critique {
    color: var(--red);
  }
  .rule__level--importante {
    color: var(--amber);
  }
  .rule__link {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-left: auto;
    border-radius: 8px;
    color: var(--dim);
    opacity: 0;
    transition:
      opacity 0.3s,
      color 0.3s,
      background-color 0.3s;
  }
  .rule:hover .rule__link,
  .rule__link:focus-visible {
    opacity: 1;
  }
  @media (hover: none) {
    .rule__link {
      opacity: 1;
    }
  }
  .rule__link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
  }
  .rule__body {
    display: grid;
    gap: 6px;
  }
  .rule__title {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 106%;
    font-size: 1.06rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .rule__body p {
    color: #c9c5dc;
    max-width: 76ch;
  }
  .rule__points {
    display: grid;
    gap: 6px;
    margin-top: 6px;
    color: #c9c5dc;
  }
  .rule__points li {
    position: relative;
    padding-left: 20px;
  }
  .rule__points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 8px;
    height: 1px;
    background: var(--a1);
  }

  /* ---- Lexique ---- */
  .lexique {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    margin: 0;
  }
  .term {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 20px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    transition:
      border-color 0.4s,
      transform 0.6s var(--ease-out);
  }
  .term:hover {
    border-color: var(--line-2);
    transform: translateY(-4px);
  }
  .term dt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .term__name {
    font-size: 1.2rem;
    line-height: 1.1;
  }
  .term__kind {
    font-size: 0.58rem;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--muted);
    white-space: nowrap;
  }
  .term__kind--obligatoire {
    color: var(--green);
    border-color: color-mix(in srgb, var(--green) 40%, transparent);
  }
  .term__kind--interdit {
    color: var(--red);
    border-color: color-mix(in srgb, var(--red) 40%, transparent);
  }
  .term dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
  }
  .term__full {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--a1);
  }

  /* ---- Aucun résultat & tomes ---- */
  .noresult {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 60px 24px;
    border: 1px dashed var(--line-2);
    border-radius: var(--radius);
    text-align: center;
    color: var(--muted);
    margin-bottom: 60px;
  }
  .noresult[hidden] {
    display: none;
  }
  .noresult b {
    color: var(--text);
  }
  .tomes {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 700px) {
    .tomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .tome {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    transition:
      transform 0.6s var(--ease-out),
      border-color 0.4s;
  }
  .tome:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--a1) 50%, transparent);
  }
  .tome__icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    color: #06060c;
    background: var(--grad-accent);
  }
  .tome small {
    display: block;
    color: var(--a1);
    font-size: 0.64rem;
  }
  .tome b {
    font-size: 1.2rem;
    line-height: 1.15;
  }
  .tome > :global(svg) {
    color: var(--muted);
  }
</style>
