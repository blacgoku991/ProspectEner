# ─────────────────────────────────────────────────────────────────────────────
# Exemple de configuration — copier en .env (développement) ou renseigner dans
# l'hébergeur. AUCUN SECRET RÉEL NE DOIT ÊTRE COMMITTÉ.
# ─────────────────────────────────────────────────────────────────────────────

# Base PostgreSQL (16 recommandé)
DATABASE_URL="postgresql://prospectener:CHANGER_MOI@127.0.0.1:5432/prospectener?schema=public"

# URL publique du site (sans / final). En production : https://votre-domaine.fr
APP_URL="http://localhost:3000"

# Secret HMAC (empreintes d'IP, de contacts, de jetons) — 32 caractères aléatoires minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=""

# Clé AES-256-GCM (32 octets en base64) pour chiffrer les secrets de double authentification.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠ La perdre rend les doubles authentifications inutilisables (réinitialisation nécessaire).
APP_ENCRYPTION_KEY=""

# Secret de la tâche planifiée (/api/cron, en-tête Authorization: Bearer …) — 24 caractères minimum.
CRON_SECRET=""

# Nombre de proxys de confiance devant l'application (lecture de X-Forwarded-For).
# 1 derrière Vercel / un reverse proxy unique ; 0 en accès direct.
TRUSTED_PROXY_HOPS=1

# Données de démonstration (développement uniquement — refusé en production).
ALLOW_DEMO_DATA=false

# ─── Notifications internes par e-mail (facultatif) ──────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Notifications <no-reply@votre-domaine.fr>"

# ─── Notifications internes par webhook (facultatif) ─────────────────────────
# Les requêtes sont signées : en-tête x-prospectener-signature = sha256=HMAC(secret, "<timestamp>.<corps>")
NOTIFY_WEBHOOK_SECRET=""

# ─── Protection anti-robots Cloudflare Turnstile (facultatif) ────────────────
# Service tiers : à mentionner dans la politique de confidentialité s'il est activé.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
